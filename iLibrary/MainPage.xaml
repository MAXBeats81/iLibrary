<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="iLibrary.MainPage"
    Title="Smart Library"
    BackgroundColor="#1E192B">

    <ScrollView>
        <VerticalStackLayout Padding="25" Spacing="20">

            <!-- Header Section -->
            <VerticalStackLayout Spacing="5" HorizontalOptions="Center">
                <Label
                    Text="iLIBRARY"
                    FontSize="32"
                    FontAttributes="Bold"
                    TextColor="#E8D7F1"
                    HorizontalOptions="Center" />
                <Label
                    Text="Smart Library Operations Dashboard"
                    FontSize="14"
                    TextColor="#B8A4C9"
                    HorizontalOptions="Center" />
            </VerticalStackLayout>

            <!-- Library Metrics 2x2 Grid -->
            <VerticalStackLayout Spacing="12">
                <Label Text="LIBRARY METRICS" FontSize="16" FontAttributes="Bold" TextColor="#D1BCE3" />

                <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,*" ColumnSpacing="12" RowSpacing="12">

                    <!-- Available Seats Card -->
                    <Border Grid.Row="0" Grid.Column="0" StrokeShape="RoundRectangle 16" 
                            BackgroundColor="#292238" Stroke="#413555" StrokeThickness="1.5" Padding="15">
                        <VerticalStackLayout Spacing="6" HorizontalOptions="Center">
                            <Label Text="SEATS" FontSize="12" TextColor="#B8A4C9" HorizontalOptions="Center" />
                            <Label x:Name="SeatsLabel" Text="--" FontSize="22" FontAttributes="Bold" TextColor="#E2D4EE" HorizontalOptions="Center" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- Borrowed Books Card -->
                    <Border Grid.Row="0" Grid.Column="1" StrokeShape="RoundRectangle 16" 
                            BackgroundColor="#292238" Stroke="#413555" StrokeThickness="1.5" Padding="15">
                        <VerticalStackLayout Spacing="6" HorizontalOptions="Center">
                            <Label Text="BORROWED" FontSize="12" TextColor="#B8A4C9" HorizontalOptions="Center" />
                            <Label x:Name="BooksLabel" Text="--" FontSize="22" FontAttributes="Bold" TextColor="#E2D4EE" HorizontalOptions="Center" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- Available Computers Card -->
                    <Border Grid.Row="1" Grid.Column="0" StrokeShape="RoundRectangle 16" 
                            BackgroundColor="#292238" Stroke="#413555" StrokeThickness="1.5" Padding="15">
                        <VerticalStackLayout Spacing="6" HorizontalOptions="Center">
                            <Label Text="COMPUTERS" FontSize="12" TextColor="#B8A4C9" HorizontalOptions="Center" />
                            <Label x:Name="ComputersLabel" Text="--" FontSize="22" FontAttributes="Bold" TextColor="#E2D4EE" HorizontalOptions="Center" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- Visitors Card -->
                    <Border Grid.Row="1" Grid.Column="1" StrokeShape="RoundRectangle 16" 
                            BackgroundColor="#292238" Stroke="#413555" StrokeThickness="1.5" Padding="15">
                        <VerticalStackLayout Spacing="6" HorizontalOptions="Center">
                            <Label Text="VISITORS" FontSize="12" TextColor="#B8A4C9" HorizontalOptions="Center" />
                            <Label x:Name="VisitorsLabel" Text="--" FontSize="22" FontAttributes="Bold" TextColor="#E2D4EE" HorizontalOptions="Center" />
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <!-- Library Status Banner Card -->
                <Border StrokeShape="RoundRectangle 16" 
                        BackgroundColor="#292238" 
                        Stroke="#413555" 
                        StrokeThickness="1.5"
                        Padding="16">
                    <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                        <Label Text="LIBRARY STATUS" FontSize="11" TextColor="#B8A4C9" HorizontalOptions="Center" />
                        <Label x:Name="StatusLabel" Text="Waiting..." FontSize="16" TextColor="#F0C2E0" FontAttributes="Bold" HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>

            <!-- Action Controls Section -->
            <VerticalStackLayout Spacing="12">
                <Button Text="REFRESH LIBRARY DATA" 
                        Clicked="RefreshData_Clicked"
                        BackgroundColor="#6A4C93"
                        TextColor="White"
                        FontAttributes="Bold"
                        CornerRadius="14"
                        HeightRequest="50" />

                <Button Text="🎤 SPEAK COMMAND" 
                        Clicked="SpeakCommand_Clicked"
                        BackgroundColor="#8358B6"
                        TextColor="White"
                        FontAttributes="Bold"
                        CornerRadius="14"
                        HeightRequest="50" />
            </VerticalStackLayout>

            <!-- Voice Command Monitor Card -->
            <Border StrokeShape="RoundRectangle 20" 
                    BackgroundColor="#292238" 
                    Stroke="#413555" 
                    StrokeThickness="1.5"
                    Padding="18">
                <VerticalStackLayout Spacing="8">
                    <Label Text="VOICE COMMAND MONITOR" FontSize="15" FontAttributes="Bold" TextColor="#D1BCE3" />
                    <Label x:Name="VoiceResultLabel" Text="Say a command..." TextColor="#C4B0D6" FontSize="15" />
                </VerticalStackLayout>
            </Border>

            <!-- System Status & Emergency Buttons -->
            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                <Button Grid.Column="0" 
                        Text="STATUS ALERT" 
                        Clicked="ShowStatus_Clicked"
                        BackgroundColor="#523B75"
                        TextColor="White"
                        CornerRadius="12"
                        HeightRequest="45" />
                <Button Grid.Column="1" 
                        Text="EMERGENCY" 
                        Clicked="Emergency_Clicked"
                        BackgroundColor="#B55276"
                        TextColor="White"
                        FontAttributes="Bold"
                        CornerRadius="12"
                        HeightRequest="45" />
            </Grid>

            <!-- Network Connectivity Card -->
            <Border StrokeShape="RoundRectangle 20" 
                    BackgroundColor="#292238" 
                    Stroke="#413555" 
                    StrokeThickness="1.5"
                    Padding="16">
                <VerticalStackLayout Spacing="6">
                    <Label Text="NETWORK CONNECTIVITY" FontSize="14" FontAttributes="Bold" TextColor="#D1BCE3" />
                    <Label x:Name="NetworkLabel" Text="Checking..." TextColor="#C4B0D6" FontSize="14" />
                </VerticalStackLayout>
            </Border>

            <!-- Blockchain Ledger Status Card -->
            <Border StrokeShape="RoundRectangle 20" 
                    BackgroundColor="#292238" 
                    Stroke="#413555" 
                    StrokeThickness="1.5"
                    Padding="16">
                <VerticalStackLayout Spacing="6">
                    <Label Text="BLOCKCHAIN LEDGER" FontSize="14" FontAttributes="Bold" TextColor="#D1BCE3" />
                    <Label x:Name="BlockchainLabel" Text="No transactions recorded yet." TextColor="#C4B0D6" FontSize="14" />
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>